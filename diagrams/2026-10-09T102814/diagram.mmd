flowchart TD
    A["个人日报 / 周报<br/>系统自动生成<br/>无需成员提交确认"] --> C["汇总团队业务数据"]
    B["团队商机 / 跟进 / 任务 / 风险"] --> C
    C --> D["自动生成<br/>团队日报 / 团队周报 / 团队 Review"]
    D --> E["主管按权限直接查看<br/>团队报告无需主管确认"]
    E --> F["下钻商机 / 跟进 / 任务<br/>核查风险与数据覆盖证据"]
    F --> G{"报告是否准确？"}
    G -->|"是"| H["形成管理动作"]
    H --> I["跟踪管理动作与业务结果"]
    I --> C
    G -->|"否"| J{"问题类型"}
    J -->|"源业务数据"| K["查看对应业务记录<br/>修正商机 / 跟进 / 任务"]
    J -->|"AI 总结"| L["反馈 AI 总结问题"]
    J -->|"数据缺失或来源不可用"| M["明确缺失范围<br/>说明对结论的影响"]
    K --> N["重新生成团队报告"]
    L --> N
    M --> N
    N --> D
