flowchart TD
    subgraph S1["销售执行循环"]
      A1["知识查询与沟通准备"] --> A2["销售活动"]
      A2 --> A3["跟进记录"]
      A3 --> A4["商机创建或更新"]
      A4 --> A5["下一步任务"]
      A5 --> A6["履约与风险提醒"]
      A6 --> A2
      A2 -.-> A7["销售活动、跟进、商机、任务与风险数据"]
      A3 -.-> A7
      A4 -.-> A7
      A5 -.-> A7
      A6 -.-> A7
    end

    subgraph S2["个人工作循环"]
      B1["今日工作建议"] --> B2["执行销售工作"]
      B2 --> B3["个人日报周报自动生成"]
      B3 --> B4["本人和有权限主管直接查看"]
      B4 -- "报告洞察反馈" --> B1
      B4 -.-> B5["无需销售确认或提交"]
    end

    subgraph S3["团队管理与学习循环"]
      C1["自动汇总个人报告与团队业务数据"] --> C2["团队日报周报与 Review"]
      C2 --> C3["主管直接查看并下钻"]
      C3 --> C4["管理动作"]
      C4 --> C5["跟踪执行结果"]
      C5 --> C6["商机复盘与打法建议"]
    end

    B2 --> A2
    A7 --> B3
    A7 --> C1
    B3 --> C1
    C6 -- "反哺知识查询" --> A1

    B3 -. "个人报告不准确" .-> D1["查看事实依据"]
    C2 -. "团队报告不准确" .-> D1
    C6 -. "复盘不准确" .-> D1
    D1 --> D2{"判断问题来源"}
    D2 -- "源数据有误" --> D3["修正跟进、商机或任务"]
    D3 --> D4["重新生成对应报告或复盘"]
    D2 -- "AI 总结不准" --> D4
