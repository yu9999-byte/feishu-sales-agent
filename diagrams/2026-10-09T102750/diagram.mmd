flowchart TD
    A["每日自动汇总本人商机、任务与风险"] --> B["生成今日工作建议"]
    B --> C["销售开展当天工作"]
    C --> D["沉淀已确认的跟进、商机与任务事实"]
    D --> E{"报告周期"}
    E -- "按日" --> F["自动生成个人日报"]
    E -- "按周" --> G["自动生成个人周报"]
    F --> H["自动保存为报告快照"]
    G --> H
    H --> I["销售本人和有权限主管可直接查看"]
    I --> J["无需销售确认或提交"]

    I -. "发现报告不准确" .-> K["查看报告中的事实依据"]
    K --> L{"问题类型"}
    L -- "源数据有误" --> M["修正跟进、商机或任务"]
    M --> N["刷新或重新生成报告"]
    L -- "数据缺失或来源不可用" --> O["标记缺失范围、更新时间和影响"]
    L -- "仅 AI 总结不准" --> P["反馈“不准确”"]
    P --> N
    N --> H
    O --> H
