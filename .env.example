# Copy this file to .env.local for local development. Never commit real values.
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# The tenant integration row points to this variable name through
# app_secret_env. Do not put an exposed or retired secret here.
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# Use websocket for local bot messages and card callbacks without a public tunnel.
# This mode supports one self-built app per Agent process.
FEISHU_RECEIVE_MODE=websocket
FEISHU_APP_ID=
# Optional while Feishu event encryption is disabled. Required after enabling
# Encrypt Key in the developer console.
FEISHU_ENCRYPT_KEY=

# P0 default: Zhipu BigModel OpenAI-compatible endpoint and free model.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash

# Optional. Defaults are 0.0.0.0 and 3100.
AGENT_HOST=0.0.0.0
AGENT_PORT=3100

# Exact public origin registered in Feishu Security Settings for Web OAuth.
# Callback URL: ${WEB_PUBLIC_URL}/api/auth/feishu/callback
WEB_PUBLIC_URL=https://YOUR_FIXED_HTTPS_DOMAIN

# Optional long-term semantic memory. Keep disabled until a persistent vector
# backend, Chinese retrieval and tenant/ACL evaluation have passed.
MEM0_ENABLED=false
MEM0_VECTOR_STORE_PROVIDER=qdrant
MEM0_VECTOR_STORE_URL=
MEM0_VECTOR_STORE_COLLECTION=sales_agent_memory
MEM0_VECTOR_STORE_DIMENSION=
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_API_KEY=
MEM0_EMBEDDER_MODEL=
MEM0_EMBEDDER_BASE_URL=
MEM0_EMBEDDER_DIMENSION=
MEM0_LLM_PROVIDER=openai
MEM0_LLM_API_KEY=
MEM0_LLM_MODEL=
MEM0_LLM_BASE_URL=
MEM0_HISTORY_DB_PATH=
AGENT_EXECUTION_TIMEOUT_MS=300000
# Short-term LangGraph conversation history lifetime. Defaults to 24 hours.
LANGGRAPH_THREAD_TTL_MS=86400000

# S4 dry-run batch scan. Keep disabled until production prerequisites pass.
# The trigger token is used only by the external scheduler and must be secret.
STALE_OPPORTUNITY_SCAN_ENABLED=false
STALE_OPPORTUNITY_TRIGGER_TOKEN=
# Reminder delivery remains disabled until historical data governance, the
# real sender and uncertain-delivery reconciliation have been verified.
STALE_OPPORTUNITY_REMINDER_ENABLED=false
STALE_OPPORTUNITY_HISTORY_GOVERNANCE_READY=false
STALE_OPPORTUNITY_REMINDER_SENDER_CONFIGURED=false
# Read-only schedule observer. This credential can inspect readiness and append
# a redacted audit event only. It must differ from both scan and execution
# tokens. Defining it does not create or enable a cron job.
STALE_OPPORTUNITY_REMINDER_SCHEDULE_OBSERVATION_TOKEN=
# Scheduler-only client settings. Use the exact protected endpoint URL. Remote
# deployments must use HTTPS; HTTP is accepted only for local loopback checks.
STALE_OPPORTUNITY_REMINDER_SCHEDULE_OBSERVATION_URL=
STALE_OPPORTUNITY_REMINDER_SCHEDULE_OBSERVATION_TIMEOUT_MS=10000
# S4 controlled real-delivery entrypoint. Keep disabled by default. The token
# must differ from STALE_OPPORTUNITY_TRIGGER_TOKEN. All three allowlist values
# are required before execution can become ready. One invocation can deliver
# at most one reminder to this member's own Feishu open_id.
STALE_OPPORTUNITY_REMINDER_EXECUTION_ENABLED=false
STALE_OPPORTUNITY_REMINDER_EXECUTION_TOKEN=
STALE_OPPORTUNITY_REMINDER_ALLOWED_TENANT_ID=
STALE_OPPORTUNITY_REMINDER_ALLOWED_MEMBER_ID=
STALE_OPPORTUNITY_REMINDER_ALLOWED_RECIPIENT_OPEN_ID=
